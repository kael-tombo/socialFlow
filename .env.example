# Public address users' browsers reach. https:// required outside localhost.
PUBLIC_URL=http://localhost:8080
PORT=8080

# 64 hex characters: openssl rand -hex 32
ENCRYPTION_KEY=

DATABASE_PATH=data/socialflow-lite.db

# LinkedIn developer app: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect".
# Redirect URL: ${PUBLIC_URL}/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202610

# X developer app: Read and write, OAuth 1.0a. Callback: ${PUBLIC_URL}/oauth/x/callback
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
