# =============================================================================
# SocialFlow.ai — production deployment environment
# =============================================================================
# Copy to deploy/socialflow/.env and fill in every REQUIRED value, then run
# deploy/socialflow/deploy.sh. Full variable reference: .env.example in the
# repository root. Secrets can alternatively be provided via *_FILE variables
# (Docker secrets); direct values win over *_FILE values.
#
# Generate strong secrets with:
#   openssl rand -base64 32
# =============================================================================

# --- Core URLs (REQUIRED) -----------------------------------------------------
# Public origin users visit. Must match what the browser sees, including the
# scheme. Set BEFORE FIRST RUN; changing it later invalidates session origins.
OPENPOST_APP_URL=https://socialflow.example.com
# Where the API/asset URLs are rooted. Defaults to OPENPOST_APP_URL when unset.
OPENPOST_PUBLIC_URL=https://socialflow.example.com
# Media delivery base. Keep the default unless media is served from another
# origin/CDN. Relative paths resolve against OPENPOST_PUBLIC_URL.
OPENPOST_MEDIA_URL=/media

# --- Secrets (REQUIRED for anything beyond local evaluation) -------------------
# Session signing key. Minimum 32 characters.
OPENPOST_JWT_SECRET=change-this-jwt-secret-min-32-chars
# Data-at-rest encryption key (workspace credentials, connected accounts).
# Minimum 32 characters. Rotating it requires the keyring procedure — see
# docs/reference/configuration/environment-variables.md before changing it
# on an existing installation.
OPENPOST_ENCRYPTION_KEY=change-this-encryption-key-32chars

# --- Server binding -------------------------------------------------------------
# Container-internal listen port. Keep 8080 unless the image is modified.
OPENPOST_PORT=8080
# Host-side bind address published by docker-compose.prod.yml.
# Keep 127.0.0.1 when the bundled Caddy proxy terminates TLS; use 0.0.0.0
# only if an external reverse proxy or firewall is in front.
SOCIALFLOW_BIND=127.0.0.1
SOCIALFLOW_PORT=8080

# --- Storage (container paths) --------------------------------------------------
# Managed by the stack's named volume; do not change for standard deployments.
OPENPOST_EDITION=selfhost
OPENPOST_DATABASE_DRIVER=sqlite
OPENPOST_DATABASE_PATH=/data/db/openpost.db
OPENPOST_STORAGE_DRIVER=local
OPENPOST_MEDIA_PATH=/data/media

# --- Access control --------------------------------------------------------------
# Set true to freeze account creation after the first admin registers.
OPENPOST_DISABLE_REGISTRATIONS=false

# --- Optional HTTPS proxy profile -------------------------------------------------
# Used only by the bundled Caddy service (docker compose --profile proxy).
SOCIALFLOW_DOMAIN=socialflow.example.com
SOCIALFLOW_ACME_EMAIL=ops@example.com

# --- Image override (optional) -----------------------------------------------------
# By default deploy.sh builds socialflow:latest from this repository.
# Point this at a registry image to skip the local build entirely.
# SOCIALFLOW_IMAGE=ghcr.io/kael-tombo/socialflow:latest
