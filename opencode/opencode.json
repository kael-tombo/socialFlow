{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "mcp": {
    "socialflow": {
      "type": "remote",
      "url": "{env:SOCIALFLOW_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:SOCIALFLOW_API_KEY}"
      },
      "oauth": false
    }
  },
  "default_agent": "operator",
  "agent": {
    "operator": {
      "description": "Operates SocialFlow Lite over MCP: account status, post status, and publishing only when you say so.",
      "mode": "primary",
      "model": "{env:SOCIALFLOW_OPERATOR_MODEL}",
      "prompt": "{file:./operator.md}",
      "steps": 12,
      "permission": {
        "*": "deny",
        "socialflow_*": "allow",
        "socialflow_publish_post": "ask",
        "socialflow_schedule_post": "ask",
        "socialflow_cancel_post": "ask",
        "socialflow_start_account_connection": "ask",
        "socialflow_disconnect_account": "deny"
      }
    }
  }
}
